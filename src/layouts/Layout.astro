---

let {title} = Astro.props;
import '../css/style.css';
import Header from '../components/Header.svelte';

const logo = "/images/noun_Tent_2517.svg";
const userIcon = "/images/noun-hiker.svg";

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sleep Outside | {title}</title>
  </head>
  <body>
    <Header logo={logo} userIcon={userIcon} client:load />
	<slot />
	<footer>&copy;NOT a real business</footer>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
