---
import Layout from "../../layouts/Layout.astro";

export const prerender = false;

const { id } = Astro.params;

if (!id) {
  return new Response("Product ID is required", { status: 400 });
}
---

<Layout title="Product">
  <main
    id="product-page"
    class="divider"
    data-product-id={id}
  >
    <section class="product-detail">
      <h1 id="product-name">Loading product...</h1>

      <div id="product-gallery" class="product-gallery" hidden>
        <div class="product-gallery__viewport">
          <img id="product-image" alt="" />
        </div>
        <div class="product-gallery__controls">
          <button
            id="product-gallery-previous"
            class="product-gallery__button"
            type="button"
            aria-label="Previous product image"
          >
            &#10094;
          </button>
          <span id="product-gallery-status" aria-live="polite"></span>
          <button
            id="product-gallery-next"
            class="product-gallery__button"
            type="button"
            aria-label="Next product image"
          >
            &#10095;
          </button>
        </div>
        <div
          id="product-gallery-indicators"
          class="product-gallery__indicators"
          role="tablist"
          aria-label="Product images"
        ></div>
      </div>

      <p id="product-price" class="product-card__price"></p>

      <p id="product-color" class="product__color"></p>
      <fieldset id="product-colors" class="product-colors" hidden>
        <legend>
          Color: <span id="selected-color-name"></span>
        </legend>
        <div id="color-swatches" class="color-swatches"></div>
      </fieldset>

      <p
        id="product-description"
        class="product__description"
      ></p>

      <div class="product-detail__add">
        <button id="addToCart" data-id={id} hidden disabled>
          Add to Cart
        </button>
      </div>

      <p id="product-error" role="alert"></p>
    </section>
  </main>

  <script src="../../js/product-detail.ts"></script>
  <script src="../../js/product.ts"></script>
</Layout>